{
  "name": "once-upon-a-stay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "demo": "tsx scripts/demo.ts",
    "format:check": "prettier --check client server shared extensions scripts tests vite.config.ts playwright.config.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check && npm run repo:check",
    "repo:check": "node scripts/check-repository.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "nodemailer": "^10.0.15",
    "openai": "^7.28.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.9",
    "rollup": "npm:@rollup/wasm-node@^4.64.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "description": "Canopia-based hackathon workbench for context enrichment and local experience discovery."
}
